/**
 * Custom Crayon Rendering Engine
 * Renders textured wax-grain, sketchy jittered paths, and layered pastel fills on HTML5 Canvas.
 */
const drawCrayonLine = (ctx, x1, y1, x2, y2, color, width = 4, roughness = 2.5) => {
  ctx.save();
  ctx.strokeStyle = color;
  ctx.lineWidth = width;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';

  const distance = Math.hypot(x2 - x1, y2 - y1);
  const steps = Math.max(1, Math.floor(distance / 4));

  for (let stroke = 0; stroke < 3; stroke++) {
    ctx.beginPath();
    ctx.globalAlpha = 0.35 + Math.random() * 0.45;
    let prevX = x1 + (Math.random() - 0.5) * roughness;
    let prevY = y1 + (Math.random() - 0.5) * roughness;
    ctx.moveTo(prevX, prevY);

    for (let i = 1; i <= steps; i++) {
      const t = i / steps;
      const currX = x1 + (x2 - x1) * t + (Math.random() - 0.5) * roughness;
      const currY = y1 + (y2 - y1) * t + (Math.random() - 0.5) * roughness;
      ctx.lineTo(currX, currY);
    }
    ctx.stroke();
  }
  ctx.restore();
};

const drawCrayonCircle = (ctx, cx, cy, radius, strokeColor, fillColor = null, width = 4) => {
  ctx.save();
  if (fillColor) {
    ctx.fillStyle = fillColor;
    for (let i = 0; i < 4; i++) {
      ctx.beginPath();
      ctx.globalAlpha = 0.22;
      ctx.arc(
        cx + (Math.random() - 0.5) * 4,
        cy + (Math.random() - 0.5) * 4,
        radius,
        0,
        Math.PI * 2
      );
      ctx.fill();
    }
  }

  // Sketchy outline
  drawCrayonLine(ctx, cx - radius, cy, cx + radius, cy, 'transparent', 1);
  for (let pass = 0; pass < 3; pass++) {
    ctx.beginPath();
    ctx.strokeStyle = strokeColor;
    ctx.lineWidth = width;
    ctx.globalAlpha = 0.6;
    ctx.arc(
      cx + (Math.random() - 0.5) * 3,
      cy + (Math.random() - 0.5) * 3,
      radius + (Math.random() - 0.5) * 2,
      0,
      Math.PI * 2
    );
    ctx.stroke();
  }
  ctx.restore();
};

const drawCrayonPoly = (ctx, points, strokeColor, fillColor = null, width = 4) => {
  if (points.length < 2) return;
  ctx.save();

  if (fillColor) {
    ctx.fillStyle = fillColor;
    for (let pass = 0; pass < 3; pass++) {
      ctx.beginPath();
      ctx.globalAlpha = 0.25;
      ctx.moveTo(points[0][0] + (Math.random() - 0.5) * 3, points[0][1] + (Math.random() - 0.5) * 3);
      for (let i = 1; i < points.length; i++) {
        ctx.lineTo(points[i][0] + (Math.random() - 0.5) * 3, points[i][1] + (Math.random() - 0.5) * 3);
      }
      ctx.closePath();
      ctx.fill();
    }
  }

  for (let i = 0; i < points.length; i++) {
    const nextIdx = (i + 1) % points.length;
    drawCrayonLine(
      ctx,
      points[i][0],
      points[i][1],
      points[nextIdx][0],
      points[nextIdx][1],
      strokeColor,
      width,
      2
    );
  }
  ctx.restore();
};

const applyPaperGrain = (ctx, width, height) => {
  ctx.save();
  // Warm off-white paper base
  ctx.fillStyle = '#fdfbf7';
  ctx.globalCompositeOperation = 'destination-over';
  ctx.fillRect(0, 0, width, height);

  // Wax particle texture
  ctx.globalCompositeOperation = 'source-over';
  ctx.fillStyle = '#2b1e16';
  const grainCount = Math.floor((width * height) / 120);
  for (let i = 0; i < grainCount; i++) {
    const x = Math.random() * width;
    const y = Math.random() * height;
    ctx.globalAlpha = Math.random() * 0.04;
    ctx.fillRect(x, y, 1.8, 1.8);
  }
  ctx.restore();
};

const renderCrayonScene = (canvas, sceneId, sceneTitle) => {
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;

  // Clear canvas
  ctx.clearRect(0, 0, w, h);

  // Coordinate Scaler based on 800x600 reference
  const sx = (x) => (x / 800) * w;
  const sy = (y) => (y / 600) * h;

  // Paper texture base
  applyPaperGrain(ctx, w, h);

  // Draw Scene Artwork
  switch (sceneId) {
    case 'scene_1': // The Vain Emperor
      // Room background wall hatching
      for (let y = 50; y < 550; y += 40) {
        drawCrayonLine(ctx, sx(50), sy(y), sx(750), sy(y), '#fde2e4', 2, 4);
      }
      // Royal Wardrobe
      drawCrayonPoly(ctx, [[sx(100), sy(180)], [sx(260), sy(180)], [sx(260), sy(500)], [sx(100), sy(500)]], '#8d99ae', '#4a4e69', 5);
      drawCrayonLine(ctx, sx(180), sy(180), sx(180), sy(500), '#2b2d42', 4);
      // Clothes on hangers
      drawCrayonPoly(ctx, [[sx(120), sy(220)], [sx(160), sy(220)], [sx(160), sy(340)], [sx(120), sy(340)]], '#ffb703', '#fb8500', 3);
      drawCrayonPoly(ctx, [[sx(200), sy(220)], [sx(240), sy(220)], [sx(240), sy(360)], [sx(200), sy(360)]], '#e63946', '#d62828', 3);

      // Emperor figure looking in Mirror
      // Large Mirror Frame
      drawCrayonPoly(ctx, [[sx(500), sy(120)], [sx(700), sy(120)], [sx(700), sy(480)], [sx(500), sy(480)]], '#ffb703', '#fff3b0', 6);
      // Mirror reflection of Emperor
      drawCrayonCircle(ctx, sx(600), sy(220), sx(35), '#1d3557', '#ffb703', 4); // Head
      drawCrayonPoly(ctx, [[sx(560), sy(260)], [sx(640), sy(260)], [sx(660), sy(440)], [sx(540), sy(440)]], '#d62828', '#e63946', 4); // Robe
      // Crown
      drawCrayonPoly(ctx, [[sx(580), sy(175)], [sx(600), sy(150)], [sx(620), sy(175)], [sx(630), sy(150)], [sx(570), sy(150)]], '#d4af37', '#ffd700', 3);

      // Real Emperor standing in foreground
      drawCrayonCircle(ctx, sx(380), sy(250), sx(40), '#222222', '#ffcdb2', 5);
      drawCrayonPoly(ctx, [[sx(330), sy(290)], [sx(430), sy(290)], [sx(450), sy(500)], [sx(310), sy(500)]], '#6b705c', '#a5a58d', 5);
      drawCrayonPoly(ctx, [[sx(360), sy(200)], [sx(380), sy(170)], [sx(400), sy(200)]], '#ffb703', '#ffb703', 4);
      break;

    case 'scene_2': // The Cunning Weavers
      // Empty Loom Frame
      drawCrayonPoly(ctx, [[sx(200), sy(100)], [sx(600), sy(100)], [sx(600), sy(460)], [sx(200), sy(460)]], '#6b705c', '#ddbea9', 8);
      drawCrayonLine(ctx, sx(240), sy(200), sx(560), sy(200), '#a5a58d', 6);
      drawCrayonLine(ctx, sx(240), sy(380), sx(560), sy(380), '#a5a58d', 6);

      // Invisible Magic Sparkles around loom
      for (let i = 0; i < 20; i++) {
        const rx = sx(260 + Math.random() * 280);
        const ry = sy(220 + Math.random() * 140);
        drawCrayonCircle(ctx, rx, ry, sx(3 + Math.random() * 4), '#7209b7', '#f72585', 2);
      }

      // Weaver 1 (Left)
      drawCrayonCircle(ctx, sx(140), sy(240), sx(32), '#1d3557', '#ffb703', 4);
      drawCrayonPoly(ctx, [[sx(110), sy(280)], [sx(170), sy(280)], [sx(180), sy(480)], [sx(100), sy(480)]], '#023e8a', '#0077b6', 4);

      // Weaver 2 (Right)
      drawCrayonCircle(ctx, sx(660), sy(240), sx(32), '#1d3557', '#ffb703', 4);
      drawCrayonPoly(ctx, [[sx(630), sy(280)], [sx(690), sy(280)], [sx(700), sy(480)], [sx(620), sy(480)]], '#2a9d8f', '#e9c46a', 4);

      // Pretend threads stretching
      drawCrayonLine(ctx, sx(170), sy(300), sx(250), sy(280), '#f72585', 3);
      drawCrayonLine(ctx, sx(630), sy(300), sx(550), sy(280), '#f72585', 3);
      break;

    case 'scene_3': // Minister Visits
      // Loom background
      drawCrayonPoly(ctx, [[sx(250), sy(120)], [sx(550), sy(120)], [sx(550), sy(380)], [sx(250), sy(380)]], '#6b705c', '#f4a261', 6);

      // Old Minister in Foreground
      drawCrayonCircle(ctx, sx(400), sy(320), sx(55), '#2b2d42', '#ffcdb2', 5); // Head
      // Spectacles
      drawCrayonCircle(ctx, sx(375), sy(310), sx(18), '#d62828', null, 4);
      drawCrayonCircle(ctx, sx(425), sy(310), sx(18), '#d62828', null, 4);
      drawCrayonLine(ctx, sx(393), sy(310), sx(407), sy(310), '#d62828', 4);

      // Robe
      drawCrayonPoly(ctx, [[sx(310), sy(380)], [sx(490), sy(380)], [sx(520), sy(580)], [sx(280), sy(580)]], '#1d3557', '#457b9d', 5);

      // Sweat drops / Panic symbols
      drawCrayonCircle(ctx, sx(470), sy(260), sx(10), '#00b4d8', '#90e0ef', 2);
      drawCrayonCircle(ctx, sx(330), sy(270), sx(8), '#00b4d8', '#90e0ef', 2);

      // Question Marks above
      ctx.font = `bold ${Math.floor(sx(48))}px sans-serif`;
      ctx.fillStyle = '#e63946';
      ctx.fillText('?', sx(340), sy(220));
      ctx.fillText('?', sx(430), sy(210));
      break;

    case 'scene_4': // Dressing Up
      // Mirror
      drawCrayonPoly(ctx, [[sx(280), sy(80)], [sx(520), sy(80)], [sx(520), sy(520)], [sx(280), sy(520)]], '#ffb703', '#e9c46a', 6);

      // Emperor standing in polka dot boxers
      drawCrayonCircle(ctx, sx(400), sy(180), sx(35), '#1d3557', '#ffcdb2', 4);
      // Boxers
      drawCrayonPoly(ctx, [[sx(360), sy(280)], [sx(440), sy(280)], [sx(450), sy(380)], [sx(350), sy(380)]], '#e63946', '#ff85a1', 4);
      // Polka dots
      drawCrayonCircle(ctx, sx(380), sy(310), sx(6), '#ffffff', '#ffffff', 1);
      drawCrayonCircle(ctx, sx(420), sy(340), sx(6), '#ffffff', '#ffffff', 1);

      // Swindlers "holding" invisible cape
      drawCrayonLine(ctx, sx(220), sy(280), sx(350), sy(260), '#7209b7', 3, 3);
      drawCrayonLine(ctx, sx(580), sy(280), sx(450), sy(260), '#7209b7', 3, 3);

      drawCrayonCircle(ctx, sx(200), sy(280), sx(28), '#1d3557', '#e9c46a', 4);
      drawCrayonCircle(ctx, sx(600), sy(280), sx(28), '#1d3557', '#2a9d8f', 4);
      break;

    case 'scene_5': // The Parade
      // Street Canopy
      drawCrayonPoly(ctx, [[sx(150), sy(80)], [sx(650), sy(80)], [sx(620), sy(140)], [sx(180), sy(140)]], '#d62828', '#f4a261', 5);

      // Emperor marching
      drawCrayonCircle(ctx, sx(400), sy(260), sx(38), '#2b2d42', '#ffcdb2', 5);
      drawCrayonPoly(ctx, [[sx(370), sy(300)], [sx(430), sy(300)], [sx(440), sy(420)], [sx(360), sy(420)]], '#ff85a1', '#ffcdb2', 4);

      // Crown
      drawCrayonPoly(ctx, [[sx(380), sy(215)], [sx(400), sy(185)], [sx(420), sy(215)]], '#ffb703', '#ffd700', 4);

      // Crowds cheering at bottom
      for (let x = 60; x < 750; x += 70) {
        drawCrayonCircle(ctx, sx(x), sy(520 + (x % 30)), sx(25), '#1d3557', '#f4a261', 3);
      }
      break;

    case 'scene_6': // The Child Points
      // Crowd
      drawCrayonPoly(ctx, [[sx(50), sy(400)], [sx(750), sy(400)], [sx(750), sy(600)], [sx(50), sy(600)]], '#2b2d42', '#3d5a80', 4);

      // Father Figure
      drawCrayonCircle(ctx, sx(260), sy(340), sx(35), '#1d3557', '#e9c46a', 5);
      // Child on Father's shoulders
      drawCrayonCircle(ctx, sx(260), sy(220), sx(28), '#d62828', '#ffcdb2', 5);

      // Pointing arm
      drawCrayonLine(ctx, sx(280), sy(230), sx(440), sy(210), '#ffcdb2', 8, 2);
      drawCrayonCircle(ctx, sx(445), sy(210), sx(8), '#ffcdb2', '#ffcdb2', 2);

      // Speech bubble
      drawCrayonPoly(ctx, [[sx(360), sy(80)], [sx(680), sy(80)], [sx(660), sy(170)], [sx(420), sy(170)], [sx(380), sy(200)]], '#1d3557', '#ffffff', 4);
      ctx.font = `bold ${Math.floor(sx(22))}px sans-serif`;
      ctx.fillStyle = '#d62828';
      ctx.fillText('He has no clothes!', sx(400), sy(130));
      break;

    case 'scene_7': // Heads High
    default:
      // Sunset Sky Background
      for (let y = 0; y < 300; y += 30) {
        drawCrayonLine(ctx, sx(0), sy(y), sx(800), sy(y), '#ffb703', 10, 6);
      }

      // Blushing / Embarrassed Emperor
      drawCrayonCircle(ctx, sx(400), sy(240), sx(45), '#1d3557', '#ff85a1', 5); // Pink face
      drawCrayonPoly(ctx, [[sx(360), sy(290)], [sx(440), sy(290)], [sx(450), sy(460)], [sx(350), sy(460)]], '#e63946', '#ffcdb2', 4);

      // Sweating drops
      drawCrayonCircle(ctx, sx(455), sy(210), sx(9), '#00b4d8', '#90e0ef', 2);

      // Courtiers behind holding empty train
      drawCrayonLine(ctx, sx(440), sy(380), sx(650), sy(410), '#ffb703', 3, 4);
      drawCrayonCircle(ctx, sx(620), sy(380), sx(30), '#1d3557', '#2a9d8f', 4);
      drawCrayonCircle(ctx, sx(680), sy(390), sx(30), '#1d3557', '#e76f51', 4);
      break;
  }
};

const CrayonCanvas = ({ sceneId, sceneTitle }) => {
  const canvasRef = useRef(null);

  useEffect(() => {
    const handleResize = () => {
      if (!canvasRef.current) return;
      const rect = canvasRef.current.parentElement.getBoundingClientRect();
      canvasRef.current.width = rect.width;
      canvasRef.current.height = rect.height;
      renderCrayonScene(canvasRef.current, sceneId, sceneTitle);
    };

    handleResize();
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, [sceneId, sceneTitle]);

  return (
    <canvas
      ref={canvasRef}
      className="w-full h-full object-cover rounded-2xl shadow-inner border border-amber-900/30"
    />
  );
};

