  const [activeStory, setActiveStory] = useState(EMPEROR_STORY);
  const [currentIndex, setCurrentIndex] = useState(0);

  // Audio & Narration State
  const [isPlayingAudio, setIsPlayingAudio] = useState(false);
  const [playbackRate, setPlaybackRate] = useState(1.0);
  const [autoAdvance, setAutoAdvance] = useState(true);
  const [voices, setVoices] = useState([]);
  const [selectedVoice, setSelectedVoice] = useState(null);
  const [speakingSentenceIndex, setSpeakingSentenceIndex] = useState(-1);

  // Touch Swipe State
  const [touchStart, setTouchStart] = useState(null);
  const [touchEnd, setTouchEnd] = useState(null);

  // PWA Installation & Offline State
  const [deferredPrompt, setDeferredPrompt] = useState(null);
  const [isInstalled, setIsInstalled] = useState(false);
  const [isOnline, setIsOnline] = useState(navigator.onLine);
  const [isPwaModalOpen, setIsPwaModalOpen] = useState(false);

  // UI Modal / Drawer States
  const [isQaOpen, setIsQaOpen] = useState(false);
  const [qaMessages, setQaMessages] = useState([
    { sender: 'ai', text: 'Welcome to the Crayon Storybook! Ask me anything about "The Emperor Has No Clothes" or its lessons.' }
  ]);
  const [customQuery, setCustomQuery] = useState('');
  const [isQaThinking, setIsQaThinking] = useState(false);

  // Custom Story Modal
  const [isCustomModalOpen, setIsCustomModalOpen] = useState(false);
  const [customForm, setCustomForm] = useState({
    title: 'The Flying Crayon Box',
    genre: 'Fantasy Adventure',
    protagonist: 'Barnaby the Doodle Dragon',
    setting: 'The Chalkland Mountains',
    prompt: 'Barnaby finds a giant magical golden crayon that brings whatever he draws to life.'
  });

  // PWA Setup & Service Worker Registration
  useEffect(() => {
    // Online / Offline status
    const handleOnline = () => setIsOnline(true);
    const handleOffline = () => setIsOnline(false);
    window.addEventListener('online', handleOnline);
    window.addEventListener('offline', handleOffline);

    // PWA Install Prompt Listener
    const handleBeforeInstall = (e) => {
      e.preventDefault();
      setDeferredPrompt(e);
    };
    window.addEventListener('beforeinstallprompt', handleBeforeInstall);

    // Register Service Worker via Blob
    if ('serviceWorker' in navigator) {
      const swUrl = generateServiceWorkerBlobUrl();
      navigator.serviceWorker.register(swUrl)
        .then(() => console.log('Offline PWA Service Worker Registered!'))
        .catch((err) => console.log('SW registration note:', err));
    }

    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
      window.removeEventListener('beforeinstallprompt', handleBeforeInstall);
    };
  }, []);

  // Speech Voices Setup
  useEffect(() => {
    if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
      const loadVoices = () => {
        const available = window.speechSynthesis.getVoices();
        setVoices(available);
        const naturalVoice = available.find(
          (v) => (v.name.includes('Natural') || v.name.includes('Google') || v.name.includes('Samantha')) && v.lang.startsWith('en')
        ) || available.find((v) => v.lang.startsWith('en')) || available[0];
        setSelectedVoice(naturalVoice);
      };
      loadVoices();
      window.speechSynthesis.onvoiceschanged = loadVoices;
    }
  }, []);

  const currentScene = useMemo(() => {
    return activeStory.scenes[currentIndex] || activeStory.scenes[0];
  }, [activeStory, currentIndex]);

  const sentences = useMemo(() => {
    if (!currentScene) return [];
    return currentScene.text.match(/[^.!?]+[.!?]+/g) || [currentScene.text];
  }, [currentScene]);

  // Audio Control Handlers
  const stopAudio = useCallback(() => {
    if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    setIsPlayingAudio(false);
    setSpeakingSentenceIndex(-1);
  }, []);

  const playAudio = useCallback(() => {
    if (typeof window === 'undefined' || !('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();

    const utterance = new SpeechSynthesisUtterance(currentScene.text);
    utterance.rate = playbackRate;
    if (selectedVoice) utterance.voice = selectedVoice;

    utterance.onstart = () => {
      setIsPlayingAudio(true);
      setSpeakingSentenceIndex(0);
    };

    let sentenceTimer;
    const avgSentenceDuration = (currentScene.text.length / sentences.length) * (85 / playbackRate);
    let currentS = 0;

    sentenceTimer = setInterval(() => {
      currentS++;
      if (currentS < sentences.length) {
        setSpeakingSentenceIndex(currentS);
      } else {
        clearInterval(sentenceTimer);
      }
    }, avgSentenceDuration);

    utterance.onend = () => {
      clearInterval(sentenceTimer);
      setIsPlayingAudio(false);
      setSpeakingSentenceIndex(-1);

      if (autoAdvance && currentIndex < activeStory.scenes.length - 1) {
        setTimeout(() => {
          setCurrentIndex((prev) => prev + 1);
        }, 800);
      }
    };

    utterance.onerror = () => {
      clearInterval(sentenceTimer);
      setIsPlayingAudio(false);
      setSpeakingSentenceIndex(-1);
    };

    window.speechSynthesis.speak(utterance);
  }, [currentScene, playbackRate, selectedVoice, autoAdvance, currentIndex, activeStory, sentences]);

  useEffect(() => {
    stopAudio();
  }, [currentIndex, stopAudio]);

  const handleNext = useCallback(() => {
    if (currentIndex < activeStory.scenes.length - 1) {
      setCurrentIndex((prev) => prev + 1);
    }
  }, [currentIndex, activeStory]);

  const handlePrev = useCallback(() => {
    if (currentIndex > 0) {
      setCurrentIndex((prev) => prev - 1);
    }
  }, [currentIndex]);

  // Swipe Gestures
  const onTouchStart = (e) => {
    setTouchEnd(null);
    setTouchStart(e.targetTouches[0].clientX);
  };
  const onTouchMove = (e) => setTouchEnd(e.targetTouches[0].clientX);
  const onTouchEnd = () => {
    if (!touchStart || !touchEnd) return;
    const distance = touchStart - touchEnd;
    if (distance > 50) handleNext();
    else if (distance < -50) handlePrev();
  };

  // PWA Install Action
  const handleInstallPwa = async () => {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    const choice = await deferredPrompt.userChoice;
    if (choice.outcome === 'accepted') {
      setIsInstalled(true);
      setDeferredPrompt(null);
    }
  };

  // AI Q&A Action
  const handleAskQuestion = (qText) => {
    if (!qText.trim() || isQaThinking) return;
    setQaMessages((prev) => [...prev, { sender: 'user', text: qText }]);
    setCustomQuery('');
    setIsQaThinking(true);

    setTimeout(() => {
      let aiReply = '';
      const lower = qText.toLowerCase();
      if (lower.includes('moral') || lower.includes('lesson')) {
        aiReply = 'The crayon story illustrates how pride and social fear can stop people from speaking plain truth. Only the innocent child had the courage to state the obvious!';
      } else if (lower.includes('child')) {
        aiReply = 'Children speak honestly because they are free from vanity, politics, and fear of judgment.';
      } else {
        aiReply = `Regarding Scene ${currentIndex + 1} ("${currentScene.title}"): The crayon visual highlights how foolish the Emperor looks when everyone pretends to see what isn't there!`;
      }
      setQaMessages((prev) => [...prev, { sender: 'ai', text: aiReply }]);
      setIsQaThinking(false);
    }, 600);
  };

  return (
    <div className="relative w-full h-screen bg-zinc-950 text-zinc-100 font-sans flex flex-col overflow-hidden select-none">
      
      {/* Top Header & PWA Banner Bar */}
      <header className="absolute top-0 left-0 right-0 z-30 px-4 py-3 bg-gradient-to-b from-zinc-950/95 via-zinc-950/70 to-transparent flex items-center justify-between backdrop-blur-md border-b border-zinc-800/40">
        <div className="flex items-center space-x-3">
          <div className="w-9 h-9 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 shadow-lg shadow-amber-500/10">
            <Feather className="w-5 h-5" />
          </div>
          <div>
            <div className="flex items-center space-x-2">
              <h1 className="text-xs font-bold tracking-wider uppercase text-amber-300">
                {activeStory.title}
              </h1>
              {/* Online / Offline Status Badge */}
              <span className={`px-1.5 py-0.5 rounded text-[9px] font-mono font-medium flex items-center gap-1 ${
                isOnline ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30'
              }`}>
                {isOnline ? <Wifi className="w-2.5 h-2.5" /> : <WifiOff className="w-2.5 h-2.5" />}
                {isOnline ? 'ONLINE' : 'OFFLINE'}
              </span>
            </div>
            <p className="text-[10px] text-zinc-400">
              Crayon Deck • Scene {currentIndex + 1} of {activeStory.scenes.length}
            </p>
          </div>
        </div>

        {/* PWA & Action Buttons */}
        <div className="flex items-center space-x-2">
          {deferredPrompt && (
            <button
              onClick={handleInstallPwa}
              className="px-2.5 py-1.5 rounded-lg bg-amber-500 text-zinc-950 font-bold text-xs flex items-center space-x-1 shadow-md hover:bg-amber-400 transition animate-bounce"
            >
              <Download className="w-3.5 h-3.5" />
              <span className="hidden sm:inline">Install PWA</span>
            </button>
          )}

          <button
            onClick={() => setIsPwaModalOpen(true)}
            className="p-2 rounded-lg bg-zinc-900 border border-zinc-700/80 text-zinc-300 hover:text-amber-400 transition"
            title="PWA Status & Manifest Export"
          >
            <Smartphone className="w-4 h-4" />
          </button>

          <button
            onClick={() => setIsQaOpen(true)}
            className="px-2.5 py-1.5 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/30 text-amber-300 text-xs font-medium flex items-center space-x-1.5 transition"
          >
            <HelpCircle className="w-3.5 h-3.5" />
            <span className="hidden sm:inline">Ask AI</span>
          </button>
        </div>
      </header>

      {/* Main Image-First Crayon Deck Area */}
      <main
        className="relative flex-1 w-full h-full flex items-center justify-center p-3 sm:p-6 pt-16 pb-32 touch-pan-y"
        onTouchStart={onTouchStart}
        onTouchMove={onTouchMove}
        onTouchEnd={onTouchEnd}
      >
        {/* Full Deck Canvas Container */}
        <div className="relative w-full h-full max-w-4xl max-h-[75vh] rounded-2xl overflow-hidden shadow-2xl border border-amber-900/40 bg-zinc-900">
          <CrayonCanvas sceneId={currentScene.id} sceneTitle={currentScene.title} />

          {/* Desktop Navigation Arrows */}
          <button
            onClick={handlePrev}
            disabled={currentIndex === 0}
            className="hidden md:flex absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-zinc-950/70 hover:bg-zinc-900 border border-zinc-700 text-zinc-200 items-center justify-center backdrop-blur-md transition disabled:opacity-20 disabled:pointer-events-none"
          >
            <ChevronLeft className="w-6 h-6" />
          </button>

          <button
            onClick={handleNext}
            disabled={currentIndex === activeStory.scenes.length - 1}
            className="hidden md:flex absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-zinc-950/70 hover:bg-zinc-900 border border-zinc-700 text-zinc-200 items-center justify-center backdrop-blur-md transition disabled:opacity-20 disabled:pointer-events-none"
          >
            <ChevronRight className="w-6 h-6" />
          </button>
        </div>

        {/* Floating Subtitle Overlay Card with Speed & Speech Controls */}
        <div className="absolute bottom-4 left-4 right-4 max-w-2xl mx-auto z-20">
          <div className="bg-zinc-900/90 backdrop-blur-xl border border-zinc-800 rounded-2xl p-4 shadow-2xl space-y-3">
            <div className="flex items-center justify-between border-b border-zinc-800 pb-2">
              <span className="text-xs font-bold text-amber-400 uppercase tracking-widest flex items-center gap-1.5">
                <BookOpen className="w-3.5 h-3.5" />
                {currentScene.title}
              </span>

              {/* Speech Controls & Speed Selector */}
              <div className="flex items-center space-x-2">
                {/* Audio Speed Selector */}
                <div className="flex items-center space-x-1 bg-zinc-950/80 p-1 rounded-lg border border-zinc-800">
                  <span className="text-[10px] text-zinc-500 font-mono px-1">Speed:</span>
                  {[0.75, 1.0, 1.25, 1.5].map((rate) => (
                    <button
                      key={rate}
                      onClick={() => setPlaybackRate(rate)}
                      className={`px-1.5 py-0.5 rounded text-[10px] font-mono transition ${
                        playbackRate === rate
                          ? 'bg-amber-500 text-zinc-950 font-bold'
                          : 'text-zinc-400 hover:text-zinc-200'
                      }`}
                    >
                      {rate}x
                    </button>
                  ))}
                </div>

                {/* Auto Advance Toggle */}
                <button
                  onClick={() => setAutoAdvance(!autoAdvance)}
                  className={`px-2 py-1 rounded text-[10px] font-medium transition ${
                    autoAdvance ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-zinc-800 text-zinc-500'
                  }`}
                >
                  Auto-Next
                </button>

                {/* Play / Pause Primary Audio Button */}
                <button
                  onClick={isPlayingAudio ? stopAudio : playAudio}
                  className="w-8 h-8 rounded-full bg-amber-500 hover:bg-amber-400 text-zinc-950 flex items-center justify-center shadow-md transition"
                >
                  {isPlayingAudio ? <Pause className="w-4 h-4 fill-current" /> : <Play className="w-4 h-4 fill-current ml-0.5" />}
                </button>
              </div>
            </div>

            {/* Subtitle Sentence Highlight */}
            <p className="text-xs sm:text-sm leading-relaxed font-serif text-zinc-200 max-h-24 overflow-y-auto">
              {sentences.map((sentence, idx) => (
                <span
                  key={idx}
                  className={`transition-colors duration-300 ${
                    isPlayingAudio && speakingSentenceIndex === idx
                      ? 'text-amber-300 font-bold bg-amber-500/20 px-1 rounded'
                      : 'text-zinc-300'
                  }`}
                >
                  {sentence}{' '}
                </span>
              ))}
            </p>

            {/* Slide Pagination Dots */}
            <div className="flex items-center justify-center space-x-1.5 pt-1">
              {activeStory.scenes.map((_, dotIdx) => (
                <button
                  key={dotIdx}
                  onClick={() => setCurrentIndex(dotIdx)}
                  className={`h-1.5 rounded-full transition-all ${
                    dotIdx === currentIndex ? 'w-6 bg-amber-400' : 'w-1.5 bg-zinc-700 hover:bg-zinc-500'
                  }`}
                />
              ))}
            </div>
          </div>
        </div>
      </main>

      {/* PWA Manifest Export & App Info Modal */}
      {isPwaModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/80 backdrop-blur-md animate-fadeIn">
          <div className="w-full max-w-lg bg-zinc-900 border border-zinc-800 rounded-2xl p-6 shadow-2xl space-y-4">
            <div className="flex items-center justify-between border-b border-zinc-800 pb-3">
              <div className="flex items-center space-x-2">
                <Smartphone className="w-5 h-5 text-amber-400" />
                <h3 className="text-sm font-bold text-zinc-200">PWA Offline & Manifest Info</h3>
              </div>
              <button
                onClick={() => setIsPwaModalOpen(false)}
                className="p-1 rounded-lg hover:bg-zinc-800 text-zinc-400"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="space-y-3 text-xs text-zinc-300">
              <p>This web application is fully built with offline Progressive Web App (PWA) capabilities.</p>
              
              <div className="p-3 bg-zinc-950 rounded-xl border border-zinc-800 space-y-1.5 font-mono text-[11px]">
                <div className="flex justify-between">
                  <span className="text-zinc-500">Service Worker:</span>
                  <span className="text-emerald-400 font-bold">Active / Registered</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-zinc-500">Network Cache:</span>
                  <span className="text-amber-300">Offline Fallback Ready</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-zinc-500">Install State:</span>
                  <span className={isInstalled ? 'text-emerald-400' : 'text-zinc-400'}>
                    {isInstalled ? 'Installed on Device' : 'Browser Mode'}
                  </span>
                </div>
              </div>

              <div>
                <label className="text-[11px] font-bold text-amber-400 block mb-1">manifest.json Snippet</label>
                <pre className="p-3 bg-zinc-950 rounded-xl border border-zinc-800 text-[10px] font-mono text-zinc-400 overflow-x-auto">
{`{
  "name": "Crayon Storyteller PWA",
  "short_name": "CrayonPWA",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#f59e0b",
  "icons": [{ "src": "/icon.png", "sizes": "512x512", "type": "image/png" }]
}`}
                </pre>
              </div>
            </div>

            <button
              onClick={() => setIsPwaModalOpen(false)}
              className="w-full py-2.5 rounded-xl bg-amber-500 text-zinc-950 font-bold text-xs hover:bg-amber-400 transition"
            >
              Done
            </button>
          </div>
        </div>
      )}

      {/* AI Story Q&A Drawer */}
      {isQaOpen && (
        <div className="fixed inset-0 z-50 flex justify-end bg-zinc-950/80 backdrop-blur-sm animate-fadeIn">
          <div className="w-full max-w-md bg-zinc-900 border-l border-zinc-800 h-full p-5 flex flex-col justify-between shadow-2xl space-y-4">
            <div className="flex items-center justify-between border-b border-zinc-800 pb-3">
              <div className="flex items-center space-x-2">
                <HelpCircle className="w-4 h-4 text-amber-400" />
                <h3 className="text-sm font-bold text-zinc-200">AI Story Companion</h3>
              </div>
              <button
                onClick={() => setIsQaOpen(false)}
                className="p-1 rounded-lg hover:bg-zinc-800 text-zinc-400"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Chat Log */}
            <div className="flex-1 overflow-y-auto space-y-3 pr-1">
              {qaMessages.map((msg, i) => (
                <div key={i} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
                  <div
                    className={`max-w-[85%] rounded-2xl p-3 text-xs leading-relaxed ${
                      msg.sender === 'user'
                        ? 'bg-amber-500/20 border border-amber-500/30 text-amber-200'
                        : 'bg-zinc-950 border border-zinc-800 text-zinc-300'
                    }`}
                  >
                    {msg.text}
                  </div>
                </div>
              ))}
              {isQaThinking && (
                <div className="text-xs text-amber-400 flex items-center space-x-2 p-2">
                  <Sparkles className="w-3.5 h-3.5 animate-spin" />
                  <span>Analyzing story context...</span>
                </div>
              )}
            </div>

            {/* Presets for current scene */}
            {currentScene.qna && (
              <div className="space-y-1.5 pt-2 border-t border-zinc-800">
                <span className="text-[10px] text-zinc-500 uppercase tracking-wider">Scene Questions</span>
                {currentScene.qna.map((preset, pIdx) => (
                  <button
                    key={pIdx}
                    onClick={() => handleAskQuestion(preset.q)}
                    className="w-full text-left p-2 rounded-xl bg-zinc-950 hover:bg-zinc-800 border border-zinc-800/80 text-[11px] text-zinc-300 hover:text-amber-300 transition"
                  >
                    {preset.q}
                  </button>
                ))}
              </div>
            )}

            {/* Custom Input */}
            <form
              onSubmit={(e) => {
                e.preventDefault();
                handleAskQuestion(customQuery);
              }}
              className="flex gap-2 pt-2 border-t border-zinc-800"
            >
              <input
                type="text"
                value={customQuery}
                onChange={(e) => setCustomQuery(e.target.value)}
                placeholder="Ask about moral or characters..."
                className="flex-1 bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-zinc-200 focus:outline-none focus:border-amber-500/50"
              />
              <button
                type="submit"
                disabled={!customQuery.trim() || isQaThinking}
                className="px-3 py-2 bg-amber-500 text-zinc-950 font-semibold rounded-xl text-xs hover:bg-amber-400 transition disabled:opacity-40"
              >
                <Send className="w-3.5 h-3.5" />
              </button>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
